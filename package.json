{
  "name": "@deepseek-ai/dsh-remote-workspace",
  "version": "0.1.0-rc.7",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "scripts": {
    "build": "tsc -b tsconfig.remote.json && pnpm --recursive --if-present run bundle",
    "build:executor-portable": "node scripts/build-portable-executor.mjs",
    "release": "node scripts/build-release.mjs",
    "start:registry": "sh scripts/start-registry.sh",
    "start:agent": "sh scripts/start-agent.sh",
    "typecheck": "tsc -b tsconfig.remote.json",
    "test": "vitest run",
    "clean": "rm -rf packages/*/*/lib packages/*/*/*.tsbuildinfo packages/executor-client/lib packages/executor-client/*.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.22.4",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "ws": "^8.21.0"
  }
}
